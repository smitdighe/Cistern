GROQ_API_KEY=
CEREBRAS_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b  # generation tier; must differ from Cerebras' gpt-oss-120b family
DATABASE_URL=              # read-only role, used for query execution
DATABASE_ADMIN_URL=        # admin role, used only for schema introspection/seeding
ENV=development
LOG_LEVEL=INFO
MAX_CORRECTION_ATTEMPTS=3
QUERY_TIMEOUT_SECONDS=10
DEFAULT_QUERY_LIMIT=500
HEALTH_CACHE_SECONDS=60    # how long /health may reuse a probe result; each refresh costs 2 provider calls + 2 DB connections
CORS_ORIGINS=http://localhost:5173   # comma-separated browser origins allowed to call the API
